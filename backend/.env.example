# Copy to .env.dev for development, or to .env.prod for the production server.
# Real values never go in this file or into Git.

# --- Django ---------------------------------------------------------------
DEBUG=True                                   # production: False
SECRET_KEY=replace-with-a-long-random-string # production: generate a new one
ALLOWED_HOSTS=127.0.0.1,localhost            # production: your domain,localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173        # production: https://your-domain (browser origin for CORS)
CSRF_TRUSTED_ORIGINS=                        # production: https://your-domain
HTTPS_ENABLED=False                          # production: True when served over HTTPS (secure cookies)
DATABASE_PATH=                               # production: /data/db.sqlite3 (empty = backend/db.sqlite3)

# --- WhatsApp Business Cloud API (Meta) ----------------------------------------
WHATSAPP_ACCESS_TOKEN=PASTE_META_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=test_notification
WHATSAPP_TEMPLATE_LANG=en

# --- Webhook (Meta calls /webhook) ---------------------------------------------
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string # must equal the verify token entered in the Meta dashboard
WHATSAPP_APP_SECRET=                              # Meta App secret; REQUIRED in production (signature check)

# --- Phone numbers ---------------------------------------------------------------
# Added to numbers typed without a country code (10 digits), so users can type 9876543210.
# Numbers typed with + or a country code are left alone. Empty disables it.
# The frontend has its own matching VITE_DEFAULT_COUNTRY_CODE (see frontend/.env.example).
DEFAULT_COUNTRY_CODE=91

# --- Email: sign-in codes and password-change codes ------------------------------
# After the password is accepted, every sign-in needs a 6-digit code emailed to the account's address.
# The same email setup sends the code for Profile > Change password.
# Leave EMAIL_HOST empty in development: the code is printed in the backend terminal.
# Production (.env.prod): fill ALL of these in, or nobody can sign in. The deploy stops before changing anything
# if they are missing. Never put the real password in this example file: it is tracked by Git.
LOGIN_OTP_REQUIRED=True                      # False turns the emailed sign-in code off (not recommended)

# Optional MPIN. When set, signing in is: email + password, then the MPIN entry, and NO email code is sent.
#   MPIN=7316    ->  at 3:30 am India time type  330a7316123   (time + MPIN + any 3 digits)
#                    at 12:05 pm India time type 1205p7316123
# Exactly 4 digits (any other value is ignored and the emailed code is used instead). One MPIN is shared by all admins.
# The time may be 1 minute off either way. 5 wrong MPINs block sign-in with it for that account for 15 minutes.
# Leave empty to use the emailed 6-digit code instead. Never commit a real MPIN.
MPIN=
EMAIL_HOST=                                  # e.g. smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=                             # the sending mailbox
EMAIL_HOST_PASSWORD=                         # Gmail: an App Password, not your normal password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=                          # empty = EMAIL_HOST_USER
