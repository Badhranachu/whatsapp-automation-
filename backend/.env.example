# Copy to .env.dev for development, or to .env.prod for the production server.
# Real values never go in this file or into Git.

# --- Django ---------------------------------------------------------------
DEBUG=True                                   # production: False
SECRET_KEY=replace-with-a-long-random-string # production: generate a new one
ALLOWED_HOSTS=127.0.0.1,localhost            # production: your domain,localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173        # production: https://your-domain (browser origin for CORS)
CSRF_TRUSTED_ORIGINS=                        # production: https://your-domain
HTTPS_ENABLED=False                          # production: True when served over HTTPS (secure cookies)
DATABASE_PATH=                               # production: /data/db.sqlite3 (empty = backend/db.sqlite3)

# --- WhatsApp Business Cloud API (Meta) ----------------------------------------
WHATSAPP_ACCESS_TOKEN=PASTE_META_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=test_notification
WHATSAPP_TEMPLATE_LANG=en

# --- Webhook (Meta calls /webhook) ---------------------------------------------
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string # must equal the verify token entered in the Meta dashboard
WHATSAPP_APP_SECRET=                              # Meta App secret; REQUIRED in production (signature check)
