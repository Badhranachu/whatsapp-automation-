# Environment files: real values never go to Git (only .env.example is tracked)
.env
.env.*
!.env.example
*.env.local

# Credentials and keys
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
.secrets/
credentials*.json
service-account*.json

# Logs, database dumps and backups can hold customer data
*.log
*.sql
*.dump
*.bak
backups/

# Python
__pycache__/
*.pyc
venv/
.venv/
db.sqlite3
*.sqlite3

# Node / build output
node_modules/
dist/
build/
