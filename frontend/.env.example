# Copy to frontend/.env for local development. These are read when the frontend is built or started.

# Backend API address. (The production build uses /api through nginx, set in docker-compose.yml.)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Added to phone numbers typed without a country code (10 digits). Empty disables it.
# Keep it equal to DEFAULT_COUNTRY_CODE in backend/.env.example.
VITE_DEFAULT_COUNTRY_CODE=91
